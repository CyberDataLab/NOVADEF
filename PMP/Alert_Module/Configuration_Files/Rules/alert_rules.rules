# ── ICMP: Ping sweep / flood ─────────────────────────────────────────────────
alert icmp any any -> any any (
    msg:"NOVADEF ICMP Ping Detected";
    itype:8;
    sid:9001001;
    rev:1;
)

# ── TCP: Escaneo de puertos SYN masivo ────────────────────────────────────────
alert tcp any any -> any any (
    msg:"NOVADEF TCP Port Scan SYN";
    flags:S;
    detection_filter:track by_src, count 5, seconds 2;
    sid:9001002;
    rev:1;
)

# ── HTTP: SQL Injection (sin flow:established) ────────────────────────────────
alert tcp any any -> any 80 (
    msg:"NOVADEF SQL Injection Attempt";
    content:"union", nocase;
    content:"select", nocase;
    sid:9001003;
    rev:1;
)

# ── HTTP: Herramienta de ataque por User-Agent ────────────────────────────────
alert tcp any any -> any 80 (
    msg:"NOVADEF Attack Tool HTTP Request";
    content:"User-Agent|3a 20|", nocase;
    pcre:"/User-Agent\s*:\s*(sqlmap|nikto|nmap|masscan)/i";
    sid:9001004;
    rev:1;
)

# ── TCP: Puerto reverse shell Metasploit ──────────────────────────────────────
alert tcp any any -> any 4444 (
    msg:"NOVADEF Possible Reverse Shell Port 4444";
    flags:S;
    sid:9001005;
    rev:1;
)