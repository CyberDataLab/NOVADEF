alert tcp any any -> any 80 (
    msg:"SQL Injection";
    flow:to_server,established;
    pcre:"/((\bunion(\s+all)?\s+select\b)|(\b(select|insert|update|delete|drop|create)\b.*\bfrom\b)|(\b(or|and)\b\s+[\'\"]?\d+[\'\"]?\s*=\s*[\'\"]?\d+[\'\"]?)|(--|%2d%2d|\/\*|%2f\*|%23))/i";
    sid:1000101;
    rev:3;
    classtype:web-application-attack;
)

# Uncomment for initial testing
# alert tcp any any <> any 443 (msg:" Alert: Traffic detected on port 443"; sid:1000001; rev:1;)

