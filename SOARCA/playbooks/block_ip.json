    "name": "Block Malicious IP via iptables",
    "description": "Block an attacker IP detected by PMP on the victim firewall via SSH.",
    "playbook_types": ["mitigation"],
    "created_by": "identity--1c5995c2-27b8-4371-a69d-6556cd689183",
    "created": "2024-05-20T00:00:00.000Z",
