    "revoked": false,
    "priority": 1,
    "severity": 80,
    "impact": 50,
    "labels": [
        "mitigation",
        "firewall",
        "pmp"
    ],
    "playbook_variables": {
        "__target_ip__": {
            "type": "ipv4-addr",
            "name": "__target_ip__",
            "description": "The malicious IP address to block.",
            "value": "0.0.0.0",
            "constant": false,
            "external": true
        }
    },
    "workflow_start": "start--5fda562d-1df9-4a94-b286-03db80c83af3",
    "workflow": {
        "start--5fda562d-1df9-4a94-b286-03db80c83af3": {
            "type": "start",
            "name": "Start Playbook",
            "on_completion": "action--286b9b45-5414-4597-8420-69292364dd5b"
        },
        "action--286b9b45-5414-4597-8420-69292364dd5b": {
            "type": "action",
            "name": "Block attacker IP via iptables",
            "description": "Uses SSH to run iptables on the victim and drop all traffic from the attacker IP.",
            "commands": [
                {
                    "type": "ssh",
                    "command": "sudo -n sh -lc 'iptables -C INPUT -s __target_ip__:value -j DROP 2>/dev/null || iptables -A INPUT -s __target_ip__:value -j DROP; iptables -C OUTPUT -d __target_ip__:value -j DROP 2>/dev/null || iptables -A OUTPUT -d __target_ip__:value -j DROP; echo DONE_BLOCK_IP'"
                }
            ],
            "agent": "soarca--b4122e67-ccb7-4117-92e3-c5060897ff74",
            "targets": [
                "linux--daea220d-6e61-4210-8794-fe3a99fac6b9"
            ],
            "on_completion": "end--21d3b5e4-cabe-44aa-a2c0-38a84ef6dd78"
        },
        "end--21d3b5e4-cabe-44aa-a2c0-38a84ef6dd78": {
            "type": "end",
            "name": "End Playbook"
        }
    },
    "agent_definitions": {
