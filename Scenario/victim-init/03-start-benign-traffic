#!/bin/sh

set -eu

if ! command -v ping >/dev/null 2>&1; then
  apk add --no-cache iputils >/dev/null 2>&1 || apk add --no-cache iputils-ping >/dev/null 2>&1 || true
fi
if ! command -v nc >/dev/null 2>&1; then
  apk add --no-cache netcat-openbsd >/dev/null 2>&1 || true
fi

mkdir -p /var/log
BENIGN_TARGET_HOST="${NOVADEF_BENIGN_TARGET_HOST:-atacante}"
if ! pgrep -f "/opt/novadef/benign_traffic_generator.sh" >/dev/null 2>&1; then
  nohup /bin/sh /opt/novadef/benign_traffic_generator.sh "${BENIGN_TARGET_HOST}" >/var/log/benign-traffic.log 2>&1 &
  echo "[victim-init] benign traffic generator started"
fi
