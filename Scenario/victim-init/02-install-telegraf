#!/bin/sh
# Instalar y arrancar Telegraf dentro del contenedor.
# La config viene montada desde el host en /etc/telegraf/telegraf.conf (read-only)
# y usa [[inputs.cgroup]] para métricas de contenedor, con machine_id como etiqueta
# identificadora única por contenedor.
if ! command -v telegraf >/dev/null 2>&1; then
  apk add --no-cache telegraf 2>/dev/null && echo "[victim-init] telegraf instalado" || echo "[victim-init] WARN: fallo instalando telegraf"
fi

if ! pgrep -f "telegraf --config /etc/telegraf/telegraf.conf" >/dev/null 2>&1; then
  nohup telegraf --config /etc/telegraf/telegraf.conf >/var/log/telegraf-victim.log 2>&1 &
  echo "[victim-init] telegraf arrancado (config: /etc/telegraf/telegraf.conf)"
fi
