# ── Python cache / temporales ────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Sistema / editor ─────────────────────────────────────────────────────────
.DS_Store

# ── Runtime logs / pids ──────────────────────────────────────────────────────
*.log
*.pid

# ── Runtime JSONL / logs de ejecución ────────────────────────────────────────
PMP/Results/Network_IDS/*.jsonl
Scenario/shared-logs/*.jsonl
Scenario/shared-logs/*.out
Scenario/artifacts/logs/*

.novadef_runtime/
.novadev_runtime/

# ── PMP_NOVADEF: pruebas internas y ficheros generados en runtime ───────────
PMP_NOVADEF/Tests/*
