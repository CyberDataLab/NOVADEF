{
  "uid": "novadef-host-metrics",
  "title": "NOVADEF - Victim Host CPU & RAM",
  "description": "CPU y RAM en tiempo real del contenedor victima scenario_victim.",
  "tags": [
    "novadef",
    "host",
    "victim",
    "cpu",
    "ram"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "editable": true,
  "links": [
    {
      "title": "Overview",
      "url": "/d/novadef-overview",
      "type": "link"
    },
    {
      "title": "Network",
      "url": "/d/novadef-network-security",
      "type": "link"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "collapsed": false,
      "id": 100,
      "title": "CPU",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "CPU Usage - current",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novadef-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novadef_live_victim_cpu_percent",
          "legendFormat": "scenario_victim",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "novadef-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU Usage - history",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novadef-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "annotationStyles": [
          {
            "id": "attack-style",
            "color": "red",
            "lineWidth": 2,
            "fillOpacity": 0,
            "hidden": false,
            "textSize": 0
          },
          {
            "id": "countermeasure-style",
            "color": "green",
            "lineWidth": 2,
            "fillOpacity": 0,
            "hidden": false,
            "textSize": 0
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novadef_live_victim_cpu_percent",
          "legendFormat": "CPU scenario_victim",
          "datasource": {
            "type": "prometheus",
            "uid": "novadef-prometheus"
          }
        }
      ]
    },
    {
      "collapsed": false,
      "id": 101,
