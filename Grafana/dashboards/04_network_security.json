  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "graphTooltip": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [
    { "title": "Overview",            "url": "/d/novadef-overview",     "type": "link", "icon": "dashboard" },
    { "title": "Security Operations", "url": "/d/novadef-security-ops", "type": "link", "icon": "shield" },
    { "title": "Host Metrics",        "url": "/d/novadef-host-metrics", "type": "link", "icon": "monitor-heart-rate" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true,
        "iconColor": "rgba(0,211,255,1)", "name": "Annotations & Alerts", "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },

  "panels": [

    {
      "collapsed": false,
      "id": 100,
      "title": "🛡️ Snort IDS — Detección de Intrusos",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 101,
      "title": "Alertas Snort (ventana)",
      "description": "Total de alertas IDS generadas por Snort3 en el rango de tiempo seleccionado",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "novadef-opensearch" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red",    "value": 10 }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "alias": "Alertas Snort",
          "bucketAggs": [
            { "field": "@timestamp", "id": "2", "settings": { "interval": "auto" }, "type": "date_histogram" }
          ],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "kafka_topic: snort_alerts",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },

