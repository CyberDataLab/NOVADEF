{
  "uid": "novadef-network-security",
  "title": "NOVADEF - Victim Network Packets",
  "description": "Paquetes por segundo del contenedor victima scenario_victim en tiempo real.",
  "tags": [
    "novadef",
    "network",
    "victim",
    "packets"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "editable": true,
  "links": [
    {
      "title": "Overview",
      "url": "/d/novadef-overview",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Host Metrics",
      "url": "/d/novadef-host-metrics",
      "type": "link",
      "icon": "monitor-heart-rate"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "collapsed": false,
      "id": 100,
      "title": "Victim Network Traffic",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Packets per second - current attack flow",
      "description": "Paquetes por segundo del flujo de ataque observado en la victima",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novadef-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "unit": "pps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novadef_live_attack_packets_per_second",
          "legendFormat": "scenario_victim attack pps",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "novadef-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Packets per second - attack flow history",
      "description": "Serie temporal del flujo de ataque observado en la victima",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novadef-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "pps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "annotationStyles": [
          {
            "id": "attack-style",
            "color": "red",
            "lineWidth": 2,
            "fillOpacity": 0,
            "hidden": false,
            "textSize": 0,
            "markerType": "arrow_up"
          },
          {
            "id": "countermeasure-style",
            "color": "green",
            "lineWidth": 2,
            "fillOpacity": 0,
            "hidden": false,
            "textSize": 0,
            "markerType": "arrow_up"
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novadef_live_attack_packets_per_second",
          "legendFormat": "scenario_victim attack pps",
          "datasource": {
            "type": "prometheus",
            "uid": "novadef-prometheus"
          }
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Attack",
        "type": "dashboard",
        "showLine": true,
        "lineColor": "red",
        "lineWidth": 2,
        "textSize": 0,
        "filter": {
          "exclude": false,
          "ids": [],
          "tags": [
            "attack"
          ]
        }
      },
      {
        "builtIn": 0,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Response",
        "type": "dashboard",
        "showLine": true,
        "lineColor": "green",
        "lineWidth": 2,
        "textSize": 0,
        "filter": {
          "exclude": false,
          "ids": [],
          "tags": [
            "countermeasure"
          ]
        }
      }
    ]
  }
}
